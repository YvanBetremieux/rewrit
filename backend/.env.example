# Database
# Note: Using postgresql+psycopg:// for psycopg3 driver
DATABASE_URL=postgresql+psycopg://localhost:5432/rewrit

# Feature Flags
# Set to 'true' to use Claude API, 'false' to use mock translations (for testing)
USE_AI=false

# App Configuration
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=*

# Quota Configuration
DAILY_QUOTA_LIMIT=100

# Rate Limiting
RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_PER_HOUR=100
