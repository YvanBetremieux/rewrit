{
  "productName": "rewrit",
  "version": "1.2.1",
  "identifier": "com.rewrit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "createUpdaterArtifacts": "v2Compatible"
  },
  "app": {
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YvanBetremieux/rewrit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0QjRGRjIxMTk2OUM0RjAKUldUd3hHa1pJZiswdEJqVGJkVTBKV04vYXdHM1V6SW9lWTZDcUNZUEQ1T1VFMFdzdkpxQkdDamcK"
    }
  }
}
