# Database (SQLite by default — no config needed)
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://localhost:5432/rewrit

# Feature Flags (AI translation is handled client-side via BYOK)
USE_AI=false

# App Configuration
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=tauri://localhost,http://localhost:5173,http://localhost:8000

# Quota Configuration
DAILY_QUOTA_LIMIT=5

# Rate Limiting
RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_PER_HOUR=100
